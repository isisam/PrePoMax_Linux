<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Reference Include="NCalc"><HintPath>$(TeachingApp)/NCalc.dll</HintPath></Reference>
    <Reference Include="Antlr3.Runtime"><HintPath>$(TeachingApp)/Antlr3.Runtime.dll</HintPath></Reference>
    <Reference Include="GmshCommon"><HintPath>$(TeachingApp)/GmshCommon.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireTeachingApp" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TeachingApp)/NCalc.dll')" Text="Set TeachingApp to the rebuilt teaching app directory." />
  </Target>
</Project>
